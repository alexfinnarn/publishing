---
/** ProblemList — the primitive. Content hands it data and says nothing about
 *  markup; the theme's `render` map says what the data IS, and one of the
 *  variants makes that claim in HTML. Content never imports this — it
 *  arrives through the theme's component map. */
import { resolveVariant } from './resolve';
import PeerSet from './problem-list/PeerSet.astro';
import LeadAndSupporting from './problem-list/LeadAndSupporting.astro';
import RankedSequence from './problem-list/RankedSequence.astro';

const { items, course = 0 } = Astro.props;
const variant = await resolveVariant(Astro.url.pathname, 'problems', course);

const BY_VARIANT = {
  'peer-set': PeerSet,
  'lead-and-supporting': LeadAndSupporting,
  'ranked-sequence': RankedSequence,
} as const;

const Variant = BY_VARIANT[variant as keyof typeof BY_VARIANT];
---
<Variant items={items} />
