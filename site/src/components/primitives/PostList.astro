---
/** PostList — the primitive. Content hands it data and says nothing about
 *  markup; the theme's `render` map says what the data IS, and one of the
 *  variants makes that claim in HTML. Content never imports this — it
 *  arrives through the theme's component map. */
import { resolveVariant } from './resolve';
import DateKeyed from './post-list/DateKeyed.astro';
import TitleLed from './post-list/TitleLed.astro';

const { items, course = 0 } = Astro.props;
const variant = await resolveVariant(Astro.url.pathname, 'posts', course);

const BY_VARIANT = {
  'date-keyed': DateKeyed,
  'title-led': TitleLed,
} as const;

const Variant = BY_VARIANT[variant as keyof typeof BY_VARIANT];
---
<Variant items={items} />
