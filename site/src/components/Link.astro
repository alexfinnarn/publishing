---
import { withBase } from '../lib/site';

/** Content writes ordinary root-absolute links (`/problems/`). MDX maps both
 *  markdown links and literal <a> elements through here so every one of them
 *  picks up the deploy's base path — Astro only rewrites the URLs it generates
 *  itself, and a hand-written root-absolute href 404s on a project site
 *  without it. That failure is invisible locally at the root and total live,
 *  which is why a test fails any href in the output that is missing it. */
const { href, ...rest } = Astro.props;
const out =
  typeof href === 'string' && href.startsWith('/') && !href.startsWith('//')
    ? withBase(href)
    : href;
---
<a href={out} {...rest}><slot /></a>
