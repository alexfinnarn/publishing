---
import { themeBase, themeOf } from '../lib/site';

/** Content writes ordinary root-absolute links (`/problems/`). MDX maps both
 *  markdown links and literal <a> elements through here, so a reader stays
 *  inside whichever theme copy they are reading — and every such link picks
 *  up the deploy's base path. The theme is derived from the URL being
 *  rendered, which keeps this component self-contained. */
const { href, ...rest } = Astro.props;
const base = themeBase(themeOf(Astro.url.pathname));
const out =
  typeof href === 'string' && href.startsWith('/') && !href.startsWith('//')
    ? base + href
    : href;
---
<a href={out} {...rest}><slot /></a>
