---
import { NAV, EMAIL } from '../lib/site';
interface Props { base: string; nav: string }
const { base, nav } = Astro.props;
const today = new Date().toLocaleDateString('en-US',
  { year: 'numeric', month: 'long', day: 'numeric' });
---
<div class="utility grid">
  <div class="inner">
    <span>Available for consulting</span>
    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
  </div>
</div>

<header class="masthead grid">
  <div class="inner">
    <a class="wordmark" href={`${base}/`}>Alex Finnarn</a>
    <p class="tagline">CMS &amp; content platforms &middot; independent consulting</p>
    <nav aria-label="Primary">
      <ul>
        {NAV.map(item => (
          <li>
            <a href={`${base}${item.href}`}
               aria-current={nav === item.key ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<div class="dateline grid">
  <div class="inner">
    <span>Drupal &amp; content platforms since 2013</span>
    <span>{today}</span>
    <span>Troy, Ohio</span>
  </div>
</div>
