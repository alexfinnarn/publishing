---
import '../styles/base.css';
import Colophon from '../components/Colophon.astro';
import { BASE, withBase } from '../lib/site';
import { themeOrDie } from '../lib/themes';

interface Props {
  theme: string;
  slug: string;
  /** Set only by the THEME_MATRIX test fixture, never by the site. */
  themedCopy?: string;
  title: string;
  headTitle?: string;
  description?: string;
  nav?: string;
  kicker?: string;
  dek?: string;
}

const { theme, slug, themedCopy, title, headTitle, description = '',
        nav = 'none', kicker, dek } = Astro.props;

const base = BASE;
// data-page lets a theme treat one page specially — broadsheet turns the
// front page into a lead-story layout with it.
const page = slug.replace(/\//g, '-');
// A theme supplies its own chrome when the furniture has to change shape, and
// inherits the plain masthead when it does not. Everything below <main> is
// the same in every theme.
const { Chrome } = themeOrDie(theme);

const fullTitle = headTitle ?? `${title} — Alex Finnarn`;

// Each page has one address. (Astro emits the 404 as a file, not a directory,
// so it is the one path that keeps an extension.)
const canonicalPath =
  slug === 'index' ? '/' : slug === '404' ? '/404.html' : `/${slug}/`;
const canonical = new URL(withBase(canonicalPath), Astro.site);
// A 404 is not an address. Fixture copies are never deployed, but they carry
// noindex too so a stray build cannot be crawled. Links stay followable.
const noindex = Boolean(themedCopy) || slug === '404';
---
<!doctype html>
<html lang="en" data-theme={theme} data-page={page}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.href} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <meta property="og:type" content={slug === 'index' ? 'website' : 'article'} />
  <meta property="og:site_name" content="Alex Finnarn" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta name="twitter:card" content="summary" />

  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  <link rel="stylesheet" href={withBase('/vendor/normalize.min.css')} />
  <link rel="stylesheet" href={withBase('/vendor/open-props.min.css')} />
  <link rel="stylesheet" href={withBase(`/styles/${theme}.css`)} />
</head>
<body class="no-js">
  <script is:inline>document.body.classList.remove("no-js")</script>
  <a class="skip" href="#main">Skip to content</a>
  <Chrome base={base} nav={nav} />

  <main id="main" class="grid">
    {kicker && <p class="kicker" set:html={kicker} />}
    <h1 set:html={title} />
    {dek && <p class="lede" set:html={dek} />}
    <slot />
  </main>

  <Colophon />
</body>
</html>
