---
import '../styles/base.css';
import Colophon from '../components/Colophon.astro';
import { themeBase, withBase } from '../lib/site';
import { themeOrDie } from '../lib/themes';

interface Props {
  theme: string;
  slug: string;
  /** Set on the per-theme copies; undefined on the curated one. */
  themedCopy?: string;
  title: string;
  headTitle?: string;
  description?: string;
  nav?: string;
  kicker?: string;
  dek?: string;
}

const { theme, slug, themedCopy, title, headTitle, description = '',
        nav = 'none', kicker, dek } = Astro.props;

const base = themeBase(themedCopy);
// data-page lets a theme treat one page specially — broadsheet turns the
// front page into a lead-story layout with it.
const page = slug.replace(/\//g, '-');
// A theme supplies its own chrome when the furniture has to change shape, and
// inherits the plain masthead when it does not. Everything below <main> is
// the same in every theme.
const { Chrome } = themeOrDie(theme);

const fullTitle = headTitle ?? `${title} — Alex Finnarn`;

// Canonical always points at the curated copy: /t/<theme>/about/ and /about/
// are the same page wearing different clothes, and only one of them should
// be the address anyone links to. (Astro emits the 404 as a file, not a
// directory, so it is the one path that keeps an extension.)
const curatedPath =
  slug === 'index' ? '/' : slug === '404' ? '/404.html' : `/${slug}/`;
const canonical = new URL(withBase(curatedPath), Astro.site);
// A themed copy is a duplicate by design, and a 404 is not an address.
// Follow the links either way so the curated pages still get found.
const noindex = Boolean(themedCopy) || slug === '404';
---
<!doctype html>
<html lang="en" data-theme={theme} data-page={page}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical.href} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <meta property="og:type" content={slug === 'index' ? 'website' : 'article'} />
  <meta property="og:site_name" content="Alex Finnarn" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical.href} />
  <meta name="twitter:card" content="summary" />

  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  <link rel="stylesheet" href={withBase('/vendor/normalize.min.css')} />
  <link rel="stylesheet" href={withBase('/vendor/open-props.min.css')} />
  <link rel="stylesheet" href={withBase(`/styles/${theme}.css`)} />
</head>
<body class="no-js">
  <script is:inline>document.body.classList.remove("no-js")</script>
  <a class="skip" href="#main">Skip to content</a>
  <Chrome base={base} nav={nav} />

  <main id="main" class="grid">
    {kicker && <p class="kicker" set:html={kicker} />}
    <h1 set:html={title} />
    {dek && <p class="lede" set:html={dek} />}
    <slot />
  </main>

  <Colophon base={base} slug={slug} current={themedCopy} />
</body>
</html>
