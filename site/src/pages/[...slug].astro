---
/** The curated site. Each page in the theme its frontmatter names. */
import { getCollection, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { elementsFor } from '../lib/themes';

export async function getStaticPaths() {
  // index has its own route; Astro normalizes `/x/index` to `/x/`,
  // which a catch-all param cannot match.
  const pages = (await getCollection('pages')).filter(p => p.id !== 'index');
  return pages.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Page theme={d.theme} slug={entry.id} title={d.title} headTitle={d.headTitle}
      description={d.description} nav={d.nav} kicker={d.kicker} dek={d.dek}>
  <Content components={elementsFor(d.theme)} />
</Page>
