---
import { getEntry, render } from 'astro:content';
import Link from '../components/Link.astro';
import Page from '../layouts/Page.astro';

const entry = await getEntry('pages', 'index');
if (!entry) throw new Error('content/pages/index.mdx is missing');
const { Content } = await render(entry);
const d = entry.data;
---
<Page theme={d.theme} slug="index" title={d.title} headTitle={d.headTitle}
      description={d.description} nav={d.nav} kicker={d.kicker} dek={d.dek}>
  <Content components={{ a: Link }} />
</Page>
