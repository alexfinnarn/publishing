---
import { getEntry, render } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import { THEME_NAMES, elementsFor } from '../../../lib/themes';

export async function getStaticPaths() {
  return THEME_NAMES.map(theme => ({ params: { theme }, props: { theme } }));
}

const { theme } = Astro.props;
const entry = await getEntry('pages', 'index');
if (!entry) throw new Error('content/pages/index.mdx is missing');
const { Content } = await render(entry);
const d = entry.data;
---
<Page theme={theme} themedCopy={theme} slug="index" title={d.title}
      headTitle={d.headTitle} description={d.description} nav={d.nav}
      kicker={d.kicker} dek={d.dek}>
  <Content components={elementsFor(theme)} />
</Page>
