---
/** The whole site in one theme, for every theme. Same content entries as the
 *  curated route — the only difference is which stylesheet and chrome the
 *  layout picks, which is the point. */
import { getCollection, render } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import { THEME_NAMES, elementsFor } from '../../../lib/themes';

export async function getStaticPaths() {
  // index has its own route; Astro normalizes `/x/index` to `/x/`,
  // which a catch-all param cannot match.
  const pages = (await getCollection('pages')).filter(p => p.id !== 'index');
  return THEME_NAMES.flatMap(theme =>
    pages.map(entry => ({
      params: { theme, slug: entry.id },
      props: { entry, theme },
    })));
}

const { entry, theme } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Page theme={theme} themedCopy={theme} slug={entry.id} title={d.title}
      headTitle={d.headTitle} description={d.description} nav={d.nav}
      kicker={d.kicker} dek={d.dek}>
  <Content components={elementsFor(theme)} />
</Page>
